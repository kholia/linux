# Help: Add PVM hosting support to the broad known-good host configuration
#
# Merge this fragment into the committed .config.  Keep the physical console
# and Intel NIC drivers needed by the NUC reference host while also retaining
# the NVMe and ENA paths needed by AWS Nitro CI hosts.

CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_PVM=y
CONFIG_KVM_INTEL=n
CONFIG_KVM_AMD=n
CONFIG_KVM_SMM=n
CONFIG_KVM_HYPERV=n
CONFIG_KVM_XEN=n
CONFIG_KVM_WERROR=n

# Preserve the relocation characteristics of the running known-good kernel.
CONFIG_RANDOMIZE_BASE=n
CONFIG_PHYSICAL_ALIGN=0x1000000

# Common EFI/NVMe host boot path.
CONFIG_BLK_DEV_INITRD=y
CONFIG_ACPI=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_EXT4_FS=y

# Keep both the NUC's local console and the EC2 serial console.
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FB_EFI=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_DRM=m
CONFIG_DRM_I915=m

# NUC I226-V networking plus AWS Nitro ENA networking.
CONFIG_NET_VENDOR_INTEL=y
CONFIG_IGC=m
CONFIG_NET_VENDOR_AMAZON=y
CONFIG_ENA_ETHERNET=m

# Filesystems used by the installed host and boot/test media.
CONFIG_ISO9660_FS=m
CONFIG_FAT_FS=m
CONFIG_VFAT_FS=m
CONFIG_OVERLAY_FS=m

# Preserve native 32-bit userspace compatibility used by the broad host.
CONFIG_IA32_EMULATION=y
