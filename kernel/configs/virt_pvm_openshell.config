# Help: Minimal, hardened OpenShell kernel for PVM guests
#
# Apply this after tinyconfig, e.g.:
#
#   make tinyconfig
#   scripts/kconfig/merge_config.sh -m .config \
#       kernel/configs/virt_pvm_openshell.config
#   make olddefconfig
#
# Everything is built in.  The image deliberately has no module loader and
# cannot consume an initramfs.  OpenShell boots it from a virtio block backed
# ext4 root filesystem.

# Small, self-contained production image.
CONFIG_EXPERT=y
CONFIG_64BIT=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_KERNEL_XZ=y
CONFIG_SMP=y
CONFIG_MODULES=n
CONFIG_BLK_DEV_INITRD=n
CONFIG_IKHEADERS=n
CONFIG_KALLSYMS=n
CONFIG_BUG=y
CONFIG_PRINTK=y
CONFIG_MULTIUSER=y
CONFIG_SYSCTL=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_COREDUMP=n
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_FHANDLE=y
CONFIG_MEMFD_CREATE=y
CONFIG_FILE_LOCKING=y
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y

# PVM and the minimal paravirtualized boot environment.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_X86_PIE=y
CONFIG_PVM_GUEST=y
CONFIG_PVM_GUEST_MINIMAL=y
CONFIG_PVH=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VIRTIO_CONSOLE=y

# Root disk and filesystems needed by the OCI/container runtime.
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLOCK_LEGACY_AUTOLOAD=n
CONFIG_BLK_DEV_WRITE_MOUNTED=n
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
# cloud-localds creates the NoCloud seed as ISO9660 by default.
CONFIG_ISO9660_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_OVERLAY_FS=y
CONFIG_FSNOTIFY=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=n
CONFIG_FUSE_FS=n
CONFIG_NETWORK_FILESYSTEMS=n
CONFIG_SWAP=n

# Namespace and process isolation.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_TIME_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CHECKPOINT_RESTORE=n
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y

# Cgroup v2 controllers used by Kubernetes and runc.
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=n
CONFIG_CGROUP_BPF=n
CONFIG_CGROUP_DEBUG=n

# Core networking and virtual interfaces.
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_XFRM=n
CONFIG_INET_DIAG=n
CONFIG_NETLINK_DIAG=n
CONFIG_PACKET_DIAG=n
CONFIG_UNIX_DIAG=n
CONFIG_NETDEVICES=y
CONFIG_VIRTIO_NET=y
CONFIG_VETH=y
CONFIG_DUMMY=y
CONFIG_TUN=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_BRIDGE_IGMP_SNOOPING=y

# Netfilter, conntrack, iptables and nftables.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_INGRESS=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_TIMEOUT=y
CONFIG_NF_CONNTRACK_TIMESTAMP=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_BPF=n
CONFIG_NF_NAT=y
# NF_NAT_MASQUERADE_IPV4 was replaced by protocol-independent masquerading.
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_TPROXY=y

# Routing, optional IPVS kube-proxy backend, and traffic control.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_ROUTE_MULTIPATH=y
CONFIG_NET_IP_TUNNEL=y
CONFIG_IP_VS=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=y
CONFIG_IP_VS_WRR=y
CONFIG_IP_VS_SH=y
CONFIG_IP_VS_NFCT=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_CLS=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y

# Sandbox security and kernel self-protection.
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,yama"
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_VMAP_STACK=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_CPU_MITIGATIONS=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_X86_KERNEL_IBT=y
CONFIG_X86_USER_SHADOW_STACK=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_ZERO_CALL_USED_REGS=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_LIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_BUCKETS=y
CONFIG_SLUB_TINY=n
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_KMALLOC_PARTITION_CACHES=y
CONFIG_PAGE_TABLE_CHECK=y
CONFIG_PAGE_TABLE_CHECK_ENFORCED=y
CONFIG_SYN_COOKIES=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LOCKDOWN_LSM=n
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_DEVMEM=n
CONFIG_DEVPORT=n
CONFIG_LEGACY_PTYS=n
CONFIG_COMPAT_BRK=n
CONFIG_COMPAT_VDSO=n
CONFIG_PROC_KCORE=n

# Remove user-reachable code loaders and large optional attack surfaces.
# NET and SECCOMP_FILTER require the internal classic BPF interpreter, so
# CONFIG_BPF itself remains selected.  No eBPF loading or JIT is present.
CONFIG_BPF_SYSCALL=n
CONFIG_BPF_JIT=n
CONFIG_BPF_PRELOAD=n
CONFIG_BPF_EVENTS=n
CONFIG_BPF_LSM=n
CONFIG_NET_CLS_BPF=n
CONFIG_NET_ACT_BPF=n
CONFIG_IO_URING=n
CONFIG_AIO=n
CONFIG_CRYPTO=n
CONFIG_CRYPTO_HW=n
CONFIG_KEYS=n
CONFIG_USERFAULTFD=n
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n
CONFIG_HIBERNATION=n
CONFIG_SUSPEND=n
CONFIG_PM=n
CONFIG_ACPI=n
CONFIG_EFI=n
CONFIG_CPU_FREQ=n
CONFIG_CPU_IDLE=n
CONFIG_SCHED_MC_PRIO=n
CONFIG_X86_INTEL_PSTATE=n
CONFIG_X86_AMD_PSTATE=n
CONFIG_MICROCODE=n
CONFIG_PROCESSOR_SELECT=y
CONFIG_CPU_SUP_CENTAUR=n
CONFIG_CPU_SUP_ZHAOXIN=n
CONFIG_CPU_SUP_HYGON=n
CONFIG_HYPERV=n
CONFIG_XEN=n
CONFIG_VMWARE_GUEST=n
CONFIG_ACRN_GUEST=n
CONFIG_JAILHOUSE_GUEST=n
CONFIG_FW_LOADER=n
CONFIG_IA32_EMULATION=n
CONFIG_X86_X32_ABI=n
CONFIG_MODIFY_LDT_SYSCALL=n
CONFIG_LEGACY_VSYSCALL_NONE=y
CONFIG_X86_MCE=n
CONFIG_PERF_EVENTS=n
CONFIG_PROFILING=n
CONFIG_KPROBES=n
CONFIG_UPROBES=n
CONFIG_FTRACE=n
CONFIG_TRACING=n
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_MAGIC_SYSRQ=n
CONFIG_KGDB=n
CONFIG_KUNIT=n
CONFIG_INPUT=n
CONFIG_HID=n
CONFIG_VT=n
CONFIG_VGA_CONSOLE=n
CONFIG_FB=n
CONFIG_FRAMEBUFFER_CONSOLE=n
CONFIG_BACKLIGHT_CLASS_DEVICE=n
CONFIG_LOGO=n
CONFIG_WIRELESS=n
CONFIG_WLAN=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_SOUND=n
CONFIG_DRM=n
CONFIG_USB_SUPPORT=n
CONFIG_PCCARD=n
CONFIG_PARPORT=n
